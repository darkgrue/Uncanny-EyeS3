### PlatformIO ###
.pioenvs
.piolibdeps
.clang_complete
.gcc-flags.json
.pio

### VisualStudioCode ###
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
#!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

### VisualStudioCode Patch ###
# Ignore all local history of files
.history
.ionide

# Support for Project snippet scope
.vscode/*.code-snippets

# Ignore code-workspaces
*.code-workspace

# Ignore Extension configurations
.VSCodeCounter

# End of https://www.toptal.com/developers/gitignore/api/platformio,visualstudiocode

# AI Assistant & Workspace configurations
.claude/
.kilo/
.cursor/
.continue/

# Superpowers Framework
# Ignore Volatile Running States & Logs
# Prevents inline batch checkpoints from filling up 'git status'
docs/superpowers/plans/
docs/superpowers/logs/
.superpowers/

# Ignore Subagent Swarm Hand-offs & Micro-states
# Cleans up cross-agent messaging artifacts from parallel loops
thoughts/shared/handoffs/
*.tmp.plan
*.execution-checkpoint

# DO NOT IGNORE: Structural Context & System Rules
# Force Git to track architectural goals so subagents don't hallucinate
!docs/superpowers/specs/

# Ignore prebuilt firmware binaries.
esp-web-tools/firmware/*.bin

# System & OS Files
.DS_Store
Thumbs.db
